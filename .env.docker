# ===== CONFIGURACIÓN DOCKER COMPOSE E-COMMERCE PIMO =====
# Copiar a .env para uso con docker-compose

# ===== JWT SEGURIDAD (CRÍTICO) =====
# Generar nuevo secreto: openssl rand -hex 32
APP_JWT_SECRET=your-super-secret-jwt-key-change-in-production-256-bits-long

# ===== BASE DE DATOS POSTGRESQL =====
POSTGRES_DB=ecommerce_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_PORT=5432

# ===== REDIS CACHE =====
REDIS_PORT=6379

# ===== PUERTOS SERVICIOS =====
ML_SERVICE_PORT=8001
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ===== ENTORNO =====
ENVIRONMENT=development
DDL_AUTO=update
SHOW_SQL=false

# ===== JWT TIEMPOS =====
# Access token: 15 min dev, 60 min prod
JWT_ACCESS_EXPIRATION=900000
# Refresh token: 7 días
JWT_REFRESH_EXPIRATION=604800000

# ===== CORS ORÍGENES =====
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ===== RECURSOS SISTEMA =====
JAVA_MAX_MEMORY=512m
JAVA_MIN_MEMORY=256m
ML_WORKERS=1
ML_TIMEOUT=30000
LOG_LEVEL=info