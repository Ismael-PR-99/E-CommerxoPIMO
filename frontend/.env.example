VITE_API_URL=http://localhost:8080/api
VITE_ML_API_URL=http://localhost:8001
# Clave pública Stripe (modo test)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx

# Copiar este archivo a .env.local o .env y ajustar valores.# Variables de entorno para Frontend
# Copiar a frontend/.env y configurar valores reales

# API URLs
VITE_API_URL=http://localhost:8080/api
VITE_ML_API_URL=http://localhost:8001/api/v1

# Environment
VITE_ENVIRONMENT=development
VITE_DEBUG=true

# Application
VITE_APP_NAME=E-CommerxoPIMO
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_ML_RECOMMENDATIONS=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_PWA=false

# External Services
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn

# Payment (Stripe)
# Nota: el código usa VITE_STRIPE_PUBLISHABLE_KEY. Mantén la antigua por retrocompatibilidad si algún script la lee.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
VITE_STRIPE_PUBLIC_KEY=pk_test_legacy_key_optional

# Maps (opcional)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Performance
VITE_ENABLE_SW=false
VITE_BUNDLE_ANALYZER=false