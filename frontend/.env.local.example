# Variables de entorno para desarrollo local del frontend

# API Backend
VITE_API_BASE_URL=http://localhost:8080/api

# ML Service
VITE_ML_API_URL=http://localhost:8001/api/v1

# Stripe Frontend (clave pública - usar test keys para desarrollo)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef...

# Environment
VITE_ENVIRONMENT=development

# ================================================
# INSTRUCCIONES DE CONFIGURACIÓN:
# ================================================
# 1. Reemplazar VITE_STRIPE_PUBLISHABLE_KEY con tu clave pública de Stripe
# 2. Para obtener la clave pública:
#    - Ir a https://dashboard.stripe.com
#    - Developers > API keys
#    - Copiar "Publishable key" (pk_test_...)
# 
# 3. Para testing, usar las siguientes tarjetas de prueba:
#    - Éxito: 4242424242424242
#    - 3D Secure: 4000002500003155
#    - Declinada: 4000000000000002
#    - Fondos insuficientes: 4000000000009995
# 
# 4. Este archivo debe estar en .gitignore para proteger las claves