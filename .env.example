# 🔐 Configuración de Seguridad JWT + CORS - E-CommerxoPIMO

# ===============================================
# CONFIGURACIÓN JWT UNIFICADA (OBLIGATORIAS)
# ===============================================

# Secreto JWT compartido entre Java y Python (CRÍTICO - CAMBIAR EN PRODUCCIÓN)
# Debe tener al menos 32 caracteres para seguridad
APP_JWT_SECRET=your_super_secret_jwt_key_with_minimum_32_characters_for_production_use_only

# Tiempo de expiración Access Token (milisegundos)
# DEV: 15 minutos = 900000ms | PROD: 60 minutos = 3600000ms
APP_JWT_ACCESS_EXPIRATION=900000

# Tiempo de expiración Refresh Token (milisegundos)  
# 7 días = 604800000ms
APP_JWT_REFRESH_EXPIRATION=604800000

# ===============================================
# CONFIGURACIÓN CORS SEGURA (OBLIGATORIAS)
# ===============================================

# Orígenes permitidos (separados por comas, SIN "*" en producción)
# DEV
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# PROD (ejemplo)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,https://admin.yourdomain.com

# Permitir credenciales (cookies, auth headers)
CORS_ALLOW_CREDENTIALS=true

# ===============================================
# BASE DE DATOS (OPCIONALES - usar si difiere del default)
# ===============================================

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce_db
DB_USERNAME=postgres
DB_PASSWORD=password

# ===============================================
# SERVICIOS (OPCIONALES)
# ===============================================

# ML Service URL para Java
ML_SERVICE_URL=http://localhost:8001

# Frontend URL para Python
FRONTEND_URL=http://localhost:5173

# Backend URL para Python  
BACKEND_URL=http://localhost:8080

# ===============================================
# DESARROLLO Y DEBUG (OPCIONALES)
# ===============================================

# Activar modo debug
DEBUG=false

# Profile activo Spring Boot (dev, prod, docker)
SPRING_PROFILES_ACTIVE=dev

# ===============================================
# EJEMPLO DE PRODUCCIÓN
# ===============================================

# APP_JWT_SECRET=prod_super_secret_key_with_256_bits_minimum_for_production_security_standards
# APP_JWT_ACCESS_EXPIRATION=3600000
# CORS_ALLOWED_ORIGINS=https://ecommerce.yourdomain.com,https://api.yourdomain.com
# DATABASE_URL=postgresql://user:pass@prod-db-host:5432/ecommerce_prod
# ML_SERVICE_URL=https://ml.yourdomain.com
# DEBUG=false
# SPRING_PROFILES_ACTIVE=prod